# Copy to .env / apps/web/.env.local. NEVER commit secrets.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL_FALLBACK=      # optional second RPC (public RPC is rate limited to 25 req/s)
NEXT_PUBLIC_GIG_ESCROW=            # GigEscrow address, after deploy (deployments/10143.json)
SESSION_SECRET=                    # random 32+ bytes; signs the sign-in cookie. Required in production builds
DATABASE_URL=                      # Postgres, schema in apps/web/db/schema.sql (job text + proposals only)

# contracts (deployer key lives in a Foundry keystore, never an env var)
DEPLOYER_ACCOUNT=
FEE_RECIPIENT=                     # receives the 5% fee
MONAD_FORK_RPC=                    # opt-in fork tests: forge test -n monad --match-path "test/fork/*"
